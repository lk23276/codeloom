# ══════════════════════════════════════════════════════════════════
#  CodeLoom 配置模板  →  复制为 .env 后填值
#
#      cp .env.example .env        # Linux / macOS / WSL
#      copy .env.example .env      # Windows cmd
#
#  ★ 纪律：.env 已被 .gitignore 忽略，【永远不要】提交。
#  ★ 本文件（.env.example）才是「项目需要哪些配置」的唯一文档，必须入库。
#  ★ 变量前缀 APP_ 对应 pydantic-settings 的 env_prefix；
#     APP_LLM_API_KEY  →  Settings.llm_api_key
# ══════════════════════════════════════════════════════════════════


# ── 大模型（必填项只有 API Key）──────────────────────────────
# 必填。留空时服务**仍能启动**（探针/会话接口可用），只有 /chat* 会返回 502
# —— 这是刻意的：没有 key 也能验证骨架，而不是整个进程起不来。
APP_LLM_API_KEY=

# OpenAI 兼容端点。DeepSeek 官方就是这个地址，不需要加 /v1
APP_LLM_BASE_URL=https://api.deepseek.com

# 模型正名。截至 2026-11，DeepSeek 官方只列两个：
#   deepseek-flash   —— 快、便宜，日常首选（本项目固定用它）
#   deepseek-v4-pro  —— 强推理档，贵，按需升级
# ★ 旧别名 deepseek-chat / deepseek-reasoner 会被【静默路由】到 deepseek-flash，
#   看着能跑，实际不是你以为的那个模型 —— 不要用。
APP_LLM_MODEL=deepseek-flash

# 思考模式。默认关：同一任务实测输出 token 77 → 12（正文一样）。
# 只有复杂推理（数学 / 多步逻辑）才值得打开。
APP_LLM_THINKING=false

# 单次请求超时（秒）。流式请求建议给足，否则长回复会被截断
APP_TIMEOUT_S=30

# 重试次数（429 / 5xx / 网络错误）。
# ★ 注意：openai SDK 自己也带重试，必须显式设 max_retries=0 关掉，
#   否则 SDK 的 2 次 × 我们的 2 次 = 6 次真实调用，账单和延迟都失控。
APP_MAX_RETRIES=2


# ── 存储 ──────────────────────────────────────────────────
# SQLite 文件路径。
#   本地开发：./data/sessions.db（相对路径会按进程 cwd 解析，建议写绝对路径或用默认）
#   容器内：  /data/sessions.db（/data 是挂载卷，归 appuser 所有）
APP_DB_PATH=./data/sessions.db


# ── 限流 ──────────────────────────────────────────────────
# 每个窗口允许的请求数（滑动窗口，按客户端 IP；只作用于 /chat 与 /chat/stream）
# ★ v0.1 是【进程内】限流：uvicorn --workers N 下额度会变成 N × rate_limit。
#   要横向扩容必须换成 Redis 计数，见 README「已知限制」。
APP_RATE_LIMIT=30

# 窗口长度（秒）。必须是正整数。
APP_RATE_WINDOW_S=60


# ── 日志 ──────────────────────────────────────────────────
# DEBUG / INFO / WARNING / ERROR
APP_LOG_LEVEL=INFO

# json：一行一个对象，给容器/采集端（默认）
# text：带 trace id 的一行文本，本地开发更好读
APP_LOG_FORMAT=json
