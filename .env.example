# ══════════════════════════════════════════════════════════════════
#  CodeLoom 配置模板  →  复制为 .env 后填值
#
#      cp .env.example .env        # Linux / macOS / WSL
#      copy .env.example .env      # Windows cmd
#
#  ★ 纪律：.env 已被 .gitignore 忽略，【永远不要】提交。
#  ★ 本文件（.env.example）才是「项目需要哪些配置」的唯一文档，必须入库。
#  ★ 变量前缀 APP_ 对应 pydantic-settings 的 env_prefix；
#     APP_LLM_API_KEY  →  Settings.llm_api_key
# ══════════════════════════════════════════════════════════════════

# ── 大模型（必填项只有 API Key）──────────────────────────────
# 必填。留空时服务**仍能启动**（探针/会话接口可用），只有 /chat* 会返回 502
# —— 这是刻意的：没有 key 也能验证骨架，而不是整个进程起不来。
APP_LLM_API_KEY=

# OpenAI 兼容端点。DeepSeek 官方就是这个地址。
APP_LLM_BASE_URL=https://api.deepseek.com

APP_LLM_MODEL=deepseek-flash

# 后端实现。openai = 手写适配层（默认）；langchain = LCEL 适配层。
# 两者对外契约完全相同，切换不改变 /chat 的响应结构。
# 选 langchain 前需先装依赖：uv add langchain-core langchain-openai
# 取舍与代价见 docs/adr/ADR-7-langchain-boundary.md
APP_LLM_BACKEND=openai

# 思考模式。默认关：同一任务实测输出 token 77 → 12（正文一样）。
# 只有复杂推理（数学 / 多步逻辑）才值得打开。
APP_LLM_THINKING=false

# 单次请求超时（秒）。流式请求建议给足，否则长回复会被截断
APP_TIMEOUT_S=30

# 重试次数（429 / 5xx / 网络错误）。
# ★ 注意：openai SDK 自己也带重试，必须显式设 max_retries=0 关掉，
#   否则两层叠加最坏是 3 次 × 3 次 = 9 次真实调用（每层 = 1 次请求 + 2 次重试），
#   账单和延迟都失控。
APP_MAX_RETRIES=2

# ── 存储 ──────────────────────────────────────────────────
# SQLite 文件路径。
#   本地开发：./data/sessions.db（相对路径会按进程 cwd 解析，建议写绝对路径或用默认）
#   容器内：  /data/sessions.db（/data 是挂载卷，归 appuser 所有）
APP_DB_PATH=./data/sessions.db


# ── RAG（检索增强）──────────────────────────────────────────
# 向量库持久化目录。索引是派生产物，由 scripts/index_corpus.py 重建，不入库。
APP_RAG_PERSIST_DIR=./data/chroma

# 中文检索模型：512 维、约 90 MB、MIT 许可。走 ONNX 推理，不需要 PyTorch。
# 首次使用会下载；国内网络需设 HF_ENDPOINT=https://hf-mirror.com（建库脚本已内置）。
APP_RAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5

# 进入上下文的块数。5 条 × 平均 495 字 ≈ 2500 字上下文。
APP_RAG_TOP_K=5

# 粗召回条数。必须大于 TOP_K：重排只能重排候选集里已有的块，
# 候选里没有正确答案时，再准的重排也救不回来。
APP_RAG_RECALL_K=20

# 重排模型（cross-encoder）。参数规模远大于 embedding，首次使用下载约 1 GB，
# 缓存在 data/fastembed（与 embedding 共用目录）。
# 运行期下载同样走 huggingface_hub，需要先设 HF_ENDPOINT（见上面的 embedding 说明）；
# 建议先在构建或部署阶段预下载，避免第一个请求等一分钟。
APP_RAG_RERANK_MODEL=BAAI/bge-reranker-base

# 拒答阈值。注意重排输出是**原始 logits**（未过 sigmoid），不是概率：
# 这个值必须在标注集上标定，默认值只是起点。判据是「低于它直接拒答，不调用模型」。
APP_RAG_MIN_RERANK_SCORE=0.2

# ── 限流 ──────────────────────────────────────────────────
# 每个窗口允许的请求数（滑动窗口，按客户端 IP；只作用于 /chat 与 /chat/stream）
# ★ v0.1 是【进程内】限流：uvicorn --workers N 下额度会变成 N × rate_limit。
#   要横向扩容必须换成 Redis 计数，见 README「已知限制」。
APP_RATE_LIMIT=30

# 窗口长度（秒）。必须是正整数。
APP_RATE_WINDOW_S=60

# ── 日志 ──────────────────────────────────────────────────
# DEBUG / INFO / WARNING / ERROR
APP_LOG_LEVEL=INFO

# json：一行一个对象，给容器/采集端（默认）
# text：带 trace id 的一行文本，本地开发更好读
APP_LOG_FORMAT=json
